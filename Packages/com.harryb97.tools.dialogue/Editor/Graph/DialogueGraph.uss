.dialogue-graph GridBackground {
    --grid-background-color: rgb(32, 32, 32);
    --line-color: rgba(193, 196, 192, 0.1);
    --thick-line-color: rgba(193, 196, 192, 0.1);
    --spacing: 20;
    --thick-lines: 5;
}

.dialogue-node #title {
    min-height: 26px;
}

.dialogue-node #title-label {
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.dialogue-node--start #title {
    background-color: rgb(46, 110, 64);
}

.dialogue-node--line #title {
    background-color: rgb(52, 88, 128);
}

.dialogue-node--choice #title {
    background-color: rgb(120, 86, 40);
}

.dialogue-node--branch #title {
    background-color: rgb(98, 66, 128);
}

.dialogue-node--actions #title {
    background-color: rgb(40, 110, 112);
}

.dialogue-node--jump #title {
    background-color: rgb(112, 54, 92);
}

.dialogue-node--end #title {
    background-color: rgb(128, 48, 48);
}

.dialogue-node--plain #title {
    background-color: rgb(70, 70, 70);
}

.dialogue-node #output .port {
    justify-content: flex-end;
}

.dialogue-node #extension {
    background-color: rgb(46, 46, 46);
}

.dialogue-node__content {
    width: 240px;
    padding: 4px;
}

.dialogue-node__character {
    margin: 0 0 4px 0;
}

.dialogue-node__text {
    margin: 0;
}

.dialogue-node__text > .unity-text-field__input,
.dialogue-node__text > .unity-base-text-field__input {
    min-height: 44px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.dialogue-node__option {
    width: 200px;
    margin: 1px 2px;
}

.dialogue-node__option > .unity-base-text-field__input {
    white-space: normal;
}

.dialogue-node__indicators {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px 4px 4px 4px;
}

.dialogue-node__indicator {
    font-size: 10px;
    color: rgb(200, 200, 200);
    background-color: rgb(64, 64, 64);
    border-radius: 3px;
    padding: 0 4px;
    margin: 2px 2px 0 0;
}

.dialogue-panel {
    min-width: 220px;
    padding: 4px;
    background-color: rgb(56, 56, 56);
}

.dialogue-panel__header {
    -unity-font-style: bold;
    margin: 4px 3px 4px 3px;
}

.dialogue-panel__item {
    margin: 2px 0;
}

.dialogue-panel__item-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialogue-group {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
}

.dialogue-group__color {
    width: 36px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    margin-right: 6px;
}

.dialogue-finder {
    background-color: rgb(42, 42, 42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(25, 25, 25);
    border-bottom-color: rgb(25, 25, 25);
    border-left-color: rgb(25, 25, 25);
    border-right-color: rgb(25, 25, 25);
    padding: 2px;
}

.dialogue-finder__list Label {
    -unity-text-align: middle-left;
    padding-left: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dialogue-finder__empty {
    padding: 4px;
    color: rgb(150, 150, 150);
}
